---
/* Flat illustrated placeholder "photos" in the earthy-retro palette.
   Swap these for real images later — the gallery markup stays the same. */
const { kind = "sun" } = Astro.props as { kind?: string };
---

<svg class="scene" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
  {kind === "sun" && (
    <Fragment>
      <rect width="100" height="100" fill="#F4EFE0" />
      <circle cx="52" cy="44" r="19" fill="#DDA030" />
      <path d="M0 74 Q30 60 55 72 T100 68 V100 H0 Z" fill="#4F5D34" />
      <path d="M0 86 Q40 74 70 84 T100 82 V100 H0 Z" fill="#2C352B" />
    </Fragment>
  )}
  {kind === "hills" && (
    <Fragment>
      <rect width="100" height="100" fill="#D9B4AE" />
      <circle cx="24" cy="26" r="12" fill="#DDA030" />
      <path d="M0 60 Q25 46 50 58 T100 54 V100 H0 Z" fill="#6E7D4A" />
      <path d="M0 74 Q30 62 60 72 T100 70 V100 H0 Z" fill="#4F5D34" />
      <path d="M0 88 Q40 80 70 88 T100 86 V100 H0 Z" fill="#2C352B" />
    </Fragment>
  )}
  {kind === "bunny" && (
    <Fragment>
      <rect width="100" height="100" fill="#D9B4AE" />
      <circle cx="72" cy="30" r="12" fill="#DDA030" />
      <ellipse cx="40" cy="30" rx="7" ry="22" fill="#4F5D34" transform="rotate(-10 40 30)" />
      <ellipse cx="58" cy="30" rx="7" ry="22" fill="#4F5D34" transform="rotate(10 58 30)" />
      <circle cx="49" cy="56" r="20" fill="#4F5D34" />
      <ellipse cx="49" cy="88" rx="29" ry="24" fill="#4F5D34" />
      <circle cx="42" cy="54" r="3" fill="#EDE7D6" />
      <circle cx="56" cy="54" r="3" fill="#EDE7D6" />
      <circle cx="49" cy="62" r="2.4" fill="#D9B4AE" />
    </Fragment>
  )}
  {kind === "moon" && (
    <Fragment>
      <rect width="100" height="100" fill="#2C352B" />
      <circle cx="62" cy="36" r="16" fill="#EDE7D6" />
      <circle cx="56" cy="30" r="14" fill="#2C352B" />
      <circle cx="24" cy="24" r="1.6" fill="#DDA030" />
      <circle cx="82" cy="60" r="1.6" fill="#DDA030" />
      <circle cx="38" cy="52" r="1.2" fill="#DDA030" />
      <path d="M0 82 Q30 72 60 82 T100 80 V100 H0 Z" fill="#4F5D34" />
    </Fragment>
  )}
  {kind === "plant" && (
    <Fragment>
      <rect width="100" height="100" fill="#F4EFE0" />
      <path d="M50 70 C50 50 40 40 34 34" stroke="#4F5D34" stroke-width="4" fill="none" stroke-linecap="round" />
      <path d="M50 70 C50 48 62 40 70 36" stroke="#4F5D34" stroke-width="4" fill="none" stroke-linecap="round" />
      <ellipse cx="30" cy="30" rx="10" ry="6" fill="#6E7D4A" transform="rotate(-30 30 30)" />
      <ellipse cx="74" cy="32" rx="10" ry="6" fill="#6E7D4A" transform="rotate(30 74 32)" />
      <ellipse cx="50" cy="24" rx="7" ry="11" fill="#4F5D34" />
      <path d="M36 70 H64 L60 92 H40 Z" fill="#B0492B" />
    </Fragment>
  )}
  {kind === "sea" && (
    <Fragment>
      <rect width="100" height="100" fill="#D9B4AE" />
      <circle cx="50" cy="38" r="15" fill="#DDA030" />
      <rect y="54" width="100" height="46" fill="#4F5D34" />
      <rect y="54" width="100" height="7" fill="#6E7D4A" />
      <rect y="70" width="100" height="5" fill="#2C352B" opacity="0.5" />
    </Fragment>
  )}
</svg>
