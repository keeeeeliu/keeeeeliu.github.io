---
import type { RoomNav } from "../data/rooms";

interface Props {
  nav: RoomNav;
}

const { nav } = Astro.props;
---

<nav class="room-nav" aria-label="Room navigation">
  <a class="room-nav-btn room-nav-prev" href={nav.prev.href} title="向后" aria-label={`Back: ${nav.prev.label}`}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M14.5 6.5 9 12l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
  {
    nav.next && (
      <div class="room-nav-rail">
        <a class="room-nav-btn room-nav-next" href={nav.next.href} title="向前" aria-label={`Next: ${nav.next.label}`}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9.5 6.5 15 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    )
  }
</nav>
