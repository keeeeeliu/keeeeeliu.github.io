---
interface Props {
  title?: string;
  src?: string;
  embedded?: boolean;
  controlsOnly?: boolean;
}

const {
  title = "chocolates in sanya",
  src = "/music/chocolates-in-sanya.wav",
  embedded = false,
  controlsOnly = false,
} = Astro.props;

const Tag = controlsOnly ? "div" : "article";
---

<Tag class:list={["sound-card", embedded && "sound-card-embedded", controlsOnly && "sound-card-controls-only"]}>
  {!controlsOnly && <p class="sound-card-title">{title}</p>}

  <div class="sound-card-controls">
    <button class="sound-card-play" type="button" aria-label={`Play ${title}`} aria-pressed="false">
      <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M9 6.5 17.5 12 9 17.5z" fill="currentColor"></path>
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <g fill="currentColor"><rect x="8.5" y="6.5" width="2.8" height="11" rx="1.4"></rect><rect x="12.7" y="6.5" width="2.8" height="11" rx="1.4"></rect></g>
      </svg>
    </button>

    <div class="sound-card-track" aria-hidden="true">
      <span class="sound-card-progress"></span>
    </div>
  </div>

  <audio loop preload="metadata" src={src}></audio>
</Tag>

<script>
  function setupSoundCards() {
    document.querySelectorAll(".sound-card").forEach((card) => {
      if ((card as HTMLElement).dataset.bound) return;
      (card as HTMLElement).dataset.bound = "1";

      const audio = card.querySelector("audio") as HTMLAudioElement | null;
      const btn = card.querySelector(".sound-card-play");
      const progress = card.querySelector(".sound-card-progress") as HTMLElement | null;
      if (!audio || !btn) return;

      const trackTitle =
        card.closest(".room")?.querySelector(".title")?.textContent?.trim() ??
        card.querySelector(".sound-card-title")?.textContent?.trim() ??
        "track";

      const sync = () => {
        const playing = !audio.paused;
        card.classList.toggle("is-playing", playing);
        btn.setAttribute("aria-pressed", String(playing));
        btn.setAttribute("aria-label", playing ? "Pause" : `Play ${trackTitle}`);
      };

      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (audio.paused) { try { await audio.play(); } catch {} }
        else { audio.pause(); }
        sync();
      });

      audio.addEventListener("timeupdate", () => {
        if (progress && audio.duration) {
          progress.style.width = (audio.currentTime / audio.duration) * 100 + "%";
        }
      });
      audio.addEventListener("play", sync);
      audio.addEventListener("pause", sync);
      sync();
    });
  }

  setupSoundCards();
  document.addEventListener("astro:page-load", setupSoundCards);
</script>
