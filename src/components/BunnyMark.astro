---
/* The living bononokoko mark — a sitting bunny with a breathing sun.
   Blinks, twitches its ears, the sun turns slowly. Add interactive to let it hop on click. */
const {
  size = 40,
  interactive = false,
  fur = "#4F5D34",
  sun = "#DDA030",
  ear = "#D9B4AE",
  eye = "#EDE7D6",
} = Astro.props as {
  size?: number;
  interactive?: boolean;
  fur?: string;
  sun?: string;
  ear?: string;
  eye?: string;
};
---

<span class:list={["bunny-mark", { interactive }]} role="img" aria-label="bononokoko — a little bunny">
  <svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
    <g class="solar">
      <g class="rays">
        <g stroke={sun} stroke-width="4" stroke-linecap="round">
          <line x1="70" y1="4" x2="70" y2="11" />
          <line x1="42" y1="30" x2="49" y2="30" />
          <line x1="91" y1="30" x2="98" y2="30" />
          <line x1="52" y1="12" x2="57" y2="17" />
          <line x1="88" y1="12" x2="83" y2="17" />
        </g>
      </g>
      <circle class="sun" cx="70" cy="30" r="16" fill={sun} />
    </g>
    <g class="ears">
      <g class="ear-left">
        <ellipse cx="41" cy="20" rx="6.5" ry="19" fill={fur} transform="rotate(-10 41 20)" />
        <ellipse cx="41" cy="22" rx="2.6" ry="11" fill={ear} transform="rotate(-10 41 22)" />
      </g>
      <g class="ear-right">
        <ellipse cx="59" cy="20" rx="6.5" ry="19" fill={fur} transform="rotate(10 59 20)" />
        <ellipse cx="59" cy="22" rx="2.6" ry="11" fill={ear} transform="rotate(10 59 22)" />
      </g>
    </g>
    <circle cx="50" cy="44" r="17" fill={fur} />
    <ellipse cx="50" cy="72" rx="25" ry="22" fill={fur} />
    <g class="eyes">
      <circle cx="44" cy="42" r="2.8" fill={eye} />
      <circle cx="56" cy="42" r="2.8" fill={eye} />
    </g>
  </svg>
</span>
