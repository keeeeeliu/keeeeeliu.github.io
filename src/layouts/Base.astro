---
import { ClientRouter } from "astro:transitions";
import BunnyMark from "../components/BunnyMark.astro";
import RoomNav from "../components/RoomNav.astro";
import { getRoomNav } from "../data/rooms";

const { title = "", description = "A digital studio by Ke Liu." } = Astro.props as {
  title?: string;
  description?: string;
};

const nav = [
  { href: "/making", label: "making" },
  { href: "/sounds", label: "sounds" },
  { href: "/words", label: "words" },
  { href: "/moments", label: "moments" },
  { href: "/bunnies", label: "the bunnies" },
  { href: "/collected", label: "collected" },
];
const path = Astro.url.pathname;
const roomNav = getRoomNav(path);

// the garden log — what changed lately
const log = [
  { date: "Jul 2026", note: "redesigned the whole house 🐇" },
  { date: "Jun 2026", note: "planted the first words" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon-bunny.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shantell+Sans:wght@700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Ma+Shan+Zheng&family=Liu+Jian+Mao+Cao&family=Work+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <title>{title && title.trim() ? `${title} · bononokoko` : "bononokoko · Ke Liu"}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <nav class="container">
        <a href="/" class="brand" aria-label="bononokoko — home">
          <BunnyMark size={34} interactive />
          <span class="wordmark">bononokoko</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="mobile-menu-panel">
            {
              nav.map((item) => (
                <a
                  class="navlink"
                  href={item.href}
                  aria-current={path === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
        <div class="navlinks">
          {
            nav.map((item) => (
              <a
                class="navlink"
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    {
      path !== "/" && (
        <div class="page-watermark" aria-hidden="true">
          <img src="/images/sig.png" alt="" decoding="async" />
        </div>
      )
    }

    <main class="container">
      <slot />
    </main>

    {roomNav && <RoomNav nav={roomNav} />}

    <footer class="site-footer">
      <div class="container">
        <span class="log-title">the garden log</span>
        <ul>
          {log.map((l) => <li><span style="color:var(--terracotta)">{l.date}</span> — {l.note}</li>)}
        </ul>
        <div class="social">
          <a href="https://github.com/keeeeeliu" aria-label="GitHub">GitHub</a>
          <a href="mailto:elkaliuke@gmail.com" aria-label="Email">Email</a>
          <a href="https://www.linkedin.com/in/ke-l-58763718a/" aria-label="LinkedIn">LinkedIn</a>
        </div>
      </div>
    </footer>

    <!-- floating music control — persists across page navigation -->
    <div class="bgm-dock" transition:persist>
      <audio id="bgm-audio" src="/music/chocolates-in-sanya.wav" loop preload="auto" controlslist="nodownload noplaybackrate noremoteplayback"></audio>
      <canvas id="bgm-viz" class="bgm-viz" aria-hidden="true"></canvas>
      <button id="bgm-toggle" class="bgm-btn" aria-label="Play background music" aria-pressed="false">
        <svg class="vinyl" viewBox="0 0 100 100" width="56" height="56" aria-hidden="true">
          <circle cx="50" cy="50" r="49" fill="#211F1B" />
          <g fill="none" stroke="rgba(237,231,214,0.10)" stroke-width="1.3">
            <circle cx="50" cy="50" r="43" />
            <circle cx="50" cy="50" r="37" />
            <circle cx="50" cy="50" r="31" />
            <circle cx="50" cy="50" r="25" />
          </g>
          <path d="M50 6 A44 44 0 0 1 94 50" fill="none" stroke="rgba(237,231,214,0.16)" stroke-width="2.5" stroke-linecap="round" />
          <circle cx="50" cy="50" r="16" fill="#DDA030" />
          <circle cx="50" cy="50" r="10" fill="none" stroke="rgba(122,84,16,0.55)" stroke-width="1" />
          <circle cx="50" cy="50" r="3" fill="#211F1B" />
        </svg>
        <span class="bgm-tip">chocolates in sanya</span>
      </button>
    </div>

    <script>
      import {
        anyAudioPlaying,
        bindSiteAudioUi,
        getBgmAudio,
        syncBgmButton,
        syncSoundsPlaylist,
      } from "../scripts/site-audio";

      // Reveal-on-scroll — re-runs after every page transition.
      function setupReveal() {
        const els = document.querySelectorAll(".reveal:not(.in)");
        if (!els.length) return;
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          }),
          { threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }

      // --- Audio + vinyl visualizer -------------------------------------------
      // The vinyl reacts to whatever is playing — the BGM dock or a track in the
      // sounds playlist. One shared AudioContext/analyser; every <audio> is routed
      // through it once, so the spinning vinyl's waveform always follows the current track.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let audioCtx: AudioContext | null = null;
      let analyser: AnalyserNode | null = null;
      let freq: Uint8Array<ArrayBuffer>, wave: Uint8Array<ArrayBuffer>;
      let vctx: CanvasRenderingContext2D | null = null;
      let vraf = 0;
      const connectedAudio = new WeakSet<HTMLAudioElement>();

      function ensureAudioGraph() {
        if (audioCtx || reduceMotion) return audioCtx;
        const AC = (window.AudioContext || (window as any).webkitAudioContext);
        if (!AC) return null;
        audioCtx = new AC();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.72;
        analyser.connect(audioCtx.destination);
        freq = new Uint8Array(new ArrayBuffer(analyser.frequencyBinCount));
        wave = new Uint8Array(new ArrayBuffer(analyser.fftSize));
        const canvas = document.getElementById("bgm-viz") as HTMLCanvasElement | null;
        if (canvas) {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = 140 * dpr;
          canvas.height = 140 * dpr;
          canvas.style.width = "140px";
          canvas.style.height = "140px";
          vctx = canvas.getContext("2d");
          vctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        return audioCtx;
      }

      function connectAudio(el: HTMLAudioElement) {
        if (reduceMotion || connectedAudio.has(el)) return;
        const c = ensureAudioGraph();
        if (!c || !analyser) return;
        try {
          c.createMediaElementSource(el).connect(analyser);
          connectedAudio.add(el);
        } catch (e) { /* already routed, or cross-origin */ }
      }

      function anyPlaying() {
        return anyAudioPlaying();
      }

      function onAudioChange() {
        syncBgmButton();
        syncSoundsPlaylist();
      }

      // One closed oscilloscope ring: the current track's waveform wraps the vinyl
      // (mirrored so the loop closes) and the whole ring breathes with the bass.
      function drawViz() {
        if (!analyser || !vctx) return;
        vraf = requestAnimationFrame(drawViz);
        analyser.getByteFrequencyData(freq);
        analyser.getByteTimeDomainData(wave);
        const size = 140, cx = size / 2, cy = size / 2;
        let bass = 0; for (let k = 0; k < 12; k++) bass += freq[k];
        bass = bass / (12 * 255);
        const baseR = 31 + bass * 15, amp = 22, points = 120;
        const step = Math.max(1, Math.floor(wave.length / (points / 2)));
        const rot = (performance.now() / 1000) * 0.25;
        vctx.clearRect(0, 0, size, size);
        vctx.beginPath();
        for (let i = 0; i <= points; i++) {
          const idx = i % points;
          const mir = idx < points / 2 ? idx : points - idx;
          const s = (wave[mir * step] - 128) / 128;
          const r = baseR + s * amp;
          const a = (idx / points) * Math.PI * 2 - Math.PI / 2 + rot;
          const x = cx + Math.cos(a) * r, y = cy + Math.sin(a) * r;
          if (i === 0) vctx.moveTo(x, y); else vctx.lineTo(x, y);
        }
        vctx.closePath();
        vctx.fillStyle = "rgba(176,73,43," + (0.08 + bass * 0.2) + ")";
        vctx.fill();
        vctx.lineJoin = "round";
        vctx.strokeStyle = "rgba(176,73,43," + (0.55 + bass * 0.4) + ")";
        vctx.lineWidth = 2.8;
        vctx.stroke();
      }
      function startViz() { if (analyser && vctx && !vraf) drawViz(); }
      function stopViz() {
        if (vraf) { cancelAnimationFrame(vraf); vraf = 0; }
        vctx?.clearRect(0, 0, 140, 140);
      }

      function updateVinyl() {
        syncBgmButton();
      }

      // Any audio starts → pause the others, route it to the analyser, spin the vinyl.
      document.addEventListener("play", (e) => {
        const el = e.target;
        if (!(el instanceof HTMLAudioElement)) return;
        document.querySelectorAll("audio").forEach((a) => { if (a !== el) (a as HTMLAudioElement).pause(); });
        connectAudio(el);
        audioCtx?.resume?.();
        updateVinyl();
        onAudioChange();
        startViz();
      }, true);

      const onAudioStop = (e: Event) => {
        if (!(e.target instanceof HTMLAudioElement)) return;
        setTimeout(() => {
          updateVinyl();
          onAudioChange();
          if (!anyPlaying()) stopViz();
        }, 0);
      };
      document.addEventListener("pause", onAudioStop, true);
      document.addEventListener("ended", onAudioStop, true);

      function setupBGM() {
        bindSiteAudioUi();
        const bgm = getBgmAudio();
        if (bgm) connectAudio(bgm);
      }

      // Discourage saving the audio — block the right-click "Save audio as" menu on media.
      document.addEventListener("contextmenu", (e) => {
        if (e.target instanceof HTMLMediaElement) e.preventDefault();
      });

      // Bunny hops when clicked (delegated once, survives navigation).
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        const m = t.closest?.(".bunny-mark.interactive");
        if (m) { m.classList.remove("hop"); void (m as HTMLElement).offsetWidth; m.classList.add("hop"); }
      });

      // Mobile menu closes after a choice or an outside tap.
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        document.querySelectorAll("details.mobile-menu[open]").forEach((menu) => {
          if (target.closest?.(".mobile-menu") === menu) {
            if (target.closest?.(".mobile-menu-panel a")) (menu as HTMLDetailsElement).open = false;
            return;
          }
          (menu as HTMLDetailsElement).open = false;
        });
      });

      document.addEventListener("astro:page-load", () => {
        setupReveal();
        setupBGM();
        onAudioChange();
        if (!anyPlaying()) stopViz();
        else startViz();
      });
      setupReveal();
      setupBGM();
    </script>
  </body>
</html>
