---
import Base from "../layouts/Base.astro";
import BunnyMark from "../components/BunnyMark.astro";
---

<Base title="making" description="Experiments and work — with the process, not just the polish.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">making</span>
    <h1>Experiments &amp; work</h1>
    <p class="lead">Where my hands get dirty.</p>
  </section>

  <section class="reveal">
    <div class="making-layout">
      <div class="making-projects">
        <a class="room room-olive" href="/projects/grad-events-copilot">
          <div>
            <span class="kicker">AI workflow tool</span>
            <div class="title">Grad Events &amp; Newsletter Copilot</div>
            <div class="desc">Turns Brown campus events into a curated grad newsletter draft, cutting monthly prep from hours to focused review.</div>
          </div>
        </a>

        <a class="room room-deep" href="/projects/learnflow">
          <div>
            <span class="kicker">chrome extension</span>
            <div class="title">LearnFlow</div>
            <div class="desc">Select any term on a page and get instant explanations, examples, and quizzes. A browser that teaches while you read.</div>
          </div>
        </a>

        <a class="room room-mustard" href="/projects/asteroids">
          <div>
            <span class="kicker">browser game</span>
            <div class="title">Asteroids</div>
            <div class="desc">A keyboard-controlled arcade game with difficulty settings, shields, portals, scoring, and animated collision logic.</div>
          </div>
        </a>

        <a class="room room-terracotta" href="/projects/parc">
          <div>
            <span class="kicker">full stack at brown · team project</span>
            <div class="title">Pediatric Anxiety Research Center</div>
            <div class="desc">Pro-bono redesign for a Brown-affiliated anxiety research center — clearer paths to care, grants, and studies.</div>
          </div>
        </a>
      </div>

      <aside class="making-aside">
        <a class="site-card" href="/projects/bononokoko">
          <BunnyMark size={54} interactive />
          <div class="site-card-text">
            <span class="site-card-kick">the site itself</span>
            <div class="site-card-title">bononokoko</div>
          <div class="site-card-desc">You're reading it — a project too.</div>
          </div>
          <span class="site-card-more">how it's built →</span>
        </a>
      </aside>
    </div>
  </section>

  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</Base>
