---
import Base from "../layouts/Base.astro";
import { rooms } from "../data/rooms";
import { tracks } from "../data/tracks";
import momentsData from "../content/moments.json";

const momentPhotos = (momentsData as { caption: string; img?: string }[])
  .filter((m) => m.img)
  .slice(0, 4);
---

<Base title="" description="A digital studio by Ke Liu — with two bunnies, some music, and a few experiments.">
  <section class="hero">
    <img class="hero-sig" src="/images/sig.png" alt="" aria-hidden="true" decoding="async" />

    <div class="hero-content">
    <span class="float" style="top:2rem; right:3rem; width:22px; height:22px; background:var(--pink);"></span>
    <span class="float" style="top:7rem; right:9rem; width:15px; height:15px; background:var(--mustard); animation-delay:-4s;"></span>
    <span class="float" style="bottom:2rem; right:5rem; width:28px; height:28px; background:var(--olive-2); animation-delay:-6s;"></span>

    <span class="eyebrow">hello · 你好 </span>
    <h1 class="headline stagger">
      <span style="animation-delay:.05s">dream</span> <span style="animation-delay:.2s">wide.</span><br />
      <span style="animation-delay:.4s">explore</span> <span style="animation-delay:.55s">inside.</span><br />
      <span class="hot" style="animation-delay:.75s">create and</span> <span class="hot" style="animation-delay:.9s">provide.</span>
    </h1>
    <p class="lead">
      A whimsical space by K.L. 刘珂— with Chris 祁缘 &amp; Oliver 奥利.
      Welcome! Pet the bunny in the corner.
    </p>
    <p style="margin-top:1.4rem;">
      <a class="cta" href="/bunnies">wander in →</a>
    </p>
    </div>
  </section>

  <section class="reveal" aria-label="Rooms">
    <div class="rooms">
      {
        rooms.map((r) =>
          r.href === "/sounds" ? (
            <a class:list={["room", r.cls, "room-sound-list"]} href={r.href}>
              <span class="kicker">{r.icon} · {tracks.length} tracks</span>
              <ul class="room-tracklist">
                {tracks.slice(0, 4).map((t) => (
                  <li><span class="rt-title">{t.title}</span><span class="rt-dur">{t.duration}</span></li>
                ))}
              </ul>
              <span class="room-tracklist-more">listen to all {tracks.length} →</span>
            </a>
          ) : r.href === "/moments" ? (
            <a class:list={["room", r.cls, "room-moments"]} href={r.href}>
              <div class="room-moments-left">
                <span class="kicker">{r.icon}</span>
                <div class="title">{r.title}</div>
                <div class="desc">{r.desc}</div>
              </div>
              <div class="moments-strip">
                {momentPhotos.map((m) => (
                  <div class="moments-pol"><img src={m.img} alt={m.caption} loading="lazy" /></div>
                ))}
                <span class="moments-more">see all →</span>
              </div>
            </a>
          ) : (
            <a class:list={["room", r.cls]} href={r.href}>
              <div>
                <span class="kicker">{r.icon}</span>
                <div class="title">{r.title}</div>
                <div class="desc">{r.desc}</div>
              </div>
              {r.swatches && (
                <div class="swatches">
                  {r.swatches.map((s) => (
                    <span style={`background:${s}`} />
                  ))}
                </div>
              )}
            </a>
          )
        )
      }
    </div>
  </section>
</Base>
