---
import Base from "../layouts/Base.astro";
import SoundCard from "../components/SoundCard.astro";
import { rooms } from "../data/rooms";
---

<Base title="" description="A small digital studio by Ke Liu — with two bunnies, some music, and a few experiments.">
  <section class="hero">
    <img class="hero-sig" src="/images/sig.png" alt="" aria-hidden="true" decoding="async" />

    <div class="hero-content">
    <span class="float" style="top:2rem; right:3rem; width:22px; height:22px; background:var(--pink);"></span>
    <span class="float" style="top:7rem; right:9rem; width:15px; height:15px; background:var(--mustard); animation-delay:-4s;"></span>
    <span class="float" style="bottom:2rem; right:5rem; width:28px; height:28px; background:var(--olive-2); animation-delay:-6s;"></span>

    <span class="eyebrow">a small digital studio · 你好</span>
    <h1 class="headline stagger">
      <span style="animation-delay:.05s">listen</span> <span style="animation-delay:.2s">X.</span><br />
      <span style="animation-delay:.4s">perceive</span> <span style="animation-delay:.55s">Y.</span><br />
      <span class="hot" style="animation-delay:.75s">build</span> <span class="hot" style="animation-delay:.9s">Z.</span>
    </h1>
    <p class="lead">
      A corner of the internet by K.L. 刘珂— with Chris &amp; Oliver.
      Welcome! Pet the bunny in the corner (it hops).
    </p>
    <p style="margin-top:1.4rem;">
      <a class="cta" href="/bunnies">wander in →</a>
    </p>
    </div>
  </section>

  <section class="reveal" aria-label="Rooms">
    <div class="rooms">
      {
        rooms.map((r) =>
          r.href === "/sounds" ? (
            <div class:list={["room", r.cls, "room-sound"]}>
              <a class="room-stretch" href={r.href} aria-label={r.icon}>
                <span class="kicker">{r.icon}</span>
                <div class="title">{r.title}</div>
                <div class="desc">{r.desc}</div>
              </a>
              <SoundCard title={r.title} embedded controlsOnly />
            </div>
          ) : (
            <a class:list={["room", r.cls]} href={r.href}>
              <div>
                <span class="kicker">{r.icon}</span>
                <div class="title">{r.title}</div>
                <div class="desc">{r.desc}</div>
              </div>
              {r.swatches && (
                <div class="swatches">
                  {r.swatches.map((s) => (
                    <span style={`background:${s}`} />
                  ))}
                </div>
              )}
            </a>
          )
        )
      }
    </div>
  </section>
</Base>
