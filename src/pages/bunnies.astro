---
import Base from "../layouts/Base.astro";
import BunnyMark from "../components/BunnyMark.astro";
import Scene from "../components/Scene.astro";
import { getCollection } from "astro:content";

const diary = (await getCollection("bunnyDiary")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const gallery = ["bunny", "sun", "hills", "plant", "moon", "sea"];
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Base title="the bunnies" description="Qi Yuan & Oliver — a living photo diary.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">the bunnies</span>
    <h1>Qi Yuan &amp; Oliver</h1>
    <p class="lead">
      Two bunnies I live with. This is their room — a diary of naps, zoomies,
      and the occasional act of destruction.
    </p>
    <p style="margin-top:1rem;"><BunnyMark size={64} interactive /></p>
  </section>

  <section class="reveal">
    <div class="rooms" style="grid-template-columns:1fr 1fr;">
      <div class="room room-pink"><div><span class="kicker">Qi Yuan · 启元</span><div class="title">the thinker</div><div class="desc">watches everything, trusts slowly, loves a warm corner.</div></div></div>
      <div class="room room-olive"><div><span class="kicker">Oliver</span><div class="title">the menace</div><div class="desc">fast, curious, has opinions about cables.</div></div></div>
    </div>
  </section>

  <section class="reveal" style="margin-top:2.5rem;">
    <h2>the photo diary</h2>
    <p class="lead" style="margin-bottom:1.25rem;">Illustrated for now — real photos drop into <code>public/images</code> and swap right in.</p>
    <div class="gallery">
      {gallery.map((k) => (
        <div class="tile"><Scene kind={k} /></div>
      ))}
    </div>
  </section>

  <section class="reveal" style="margin-top:2.5rem;">
    <h2>from the diary</h2>
    <div class="diary">
      {diary.map((e) => (
        <article class="entry">
          <div class="date">{fmt(e.data.date)}</div>
          <h3>{e.data.title}</h3>
          <p>{e.data.body}</p>
        </article>
      ))}
    </div>
  </section>

</Base>
