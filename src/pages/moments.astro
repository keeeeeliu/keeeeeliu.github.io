---
import Base from "../layouts/Base.astro";
import Scene from "../components/Scene.astro";
import momentsData from "../content/moments.json";

type Moment = {
  id: string;
  caption: string;
  date: string;
  kind: string;
  img?: string;
};

const moments = [...(momentsData as Moment[])].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);
const fmt = (d: string) => new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric" });
---

<Base title="moments" description="A photo log of ordinary days.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">moments</span>
    <h1>A photo log</h1>
    <p class="lead">Ordinary days... not really.</p>
  </section>

  <section>
    <div class="polaroids">
      {moments.map((m) => (
        <figure class="polaroid">
          <div class="frame">
            {m.img ? <img src={m.img} alt={m.caption} width="1200" height="1200" /> : <Scene kind={m.kind} />}
          </div>
          <figcaption>
            <span>{m.caption}</span>
            <span class="pdate">{fmt(m.date)}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
