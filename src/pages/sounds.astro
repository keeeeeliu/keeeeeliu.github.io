---
import Base from "../layouts/Base.astro";
import { tracks } from "../data/tracks";
---

<Base title="sounds" description="A listening room — music I made, AI-assisted.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">sounds · made by bonono · ai-assisted</span>
    <h1>A listening room</h1>
    <p class="lead">Had fun with Suno. Press play — turn the volume up.</p>
  </section>

  <section class="reveal">
    <ol class="playlist">
      {
        tracks.map((t, i) => (
          <li class="track">
            <button class="track-play" type="button" data-src={t.src} aria-label={`Play ${t.title}`} aria-pressed="false">
              <svg class="icon-play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M7.5 5 19 12 7.5 19z" fill="currentColor"></path>
              </svg>
              <svg class="icon-pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <g fill="currentColor"><rect x="7.5" y="5.5" width="3.4" height="13" rx="1.6"></rect><rect x="13.1" y="5.5" width="3.4" height="13" rx="1.6"></rect></g>
              </svg>
            </button>
            <span class="track-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="track-meta">
              <span class="track-titleline">
                <span class="track-title">{t.title}</span>
                {t.tag && <span class="track-tag">{t.tag}</span>}
              </span>
            </span>
            <span class="track-eq" aria-hidden="true"><span style="--eq-delay:0s" /><span style="--eq-delay:.12s" /><span style="--eq-delay:.24s" /><span style="--eq-delay:.36s" /></span>
            <span class="track-dur">{t.duration}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <script>
    import {
      getCurrentTrack,
      normalizeSrc,
      pauseAllAudio,
      playTrack,
      syncSoundsPlaylist,
    } from "../scripts/site-audio";

    function setupPlaylist() {
      const playlist = document.querySelector(".playlist");
      if (!playlist || (playlist as HTMLElement).dataset.bound) return;
      (playlist as HTMLElement).dataset.bound = "1";

      playlist.querySelectorAll<HTMLElement>(".track").forEach((track) => {
        const btn = track.querySelector(".track-play") as HTMLButtonElement | null;
        const src = btn?.dataset.src;
        if (!btn || !src) return;

        btn.addEventListener("click", async () => {
          const title = track.querySelector(".track-title")?.textContent?.trim() || "track";
          const { src: current, playing } = getCurrentTrack();

          if (normalizeSrc(src) === current && playing) {
            pauseAllAudio();
          } else {
            await playTrack(src, title);
          }
          syncSoundsPlaylist();
        });
      });

      syncSoundsPlaylist();
    }

    setupPlaylist();
    document.addEventListener("astro:page-load", setupPlaylist);
    document.addEventListener("site-audio:change", () => syncSoundsPlaylist());
  </script>
</Base>
