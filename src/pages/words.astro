---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const essays = (await getCollection("words")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fragments = (await getCollection("fragments")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Base title="words" description="Essays and short fragments.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">words</span>
    <h1>Essays &amp; fragments</h1>
    <p class="lead">Longer pieces when I have something to say, short fragments when I don't.</p>
  </section>

  <section class="reveal">
    <h2>essays</h2>
    {essays.length > 0 ? (
      <ul class="entry-list">
        {essays.map((e) => (
          <li>
            <a href={`/words/${e.id}`} class="voice entry-title">{e.data.title}</a>
            <div class="entry-meta">{fmt(e.data.date)}{e.data.summary ? ` · ${e.data.summary}` : ""}</div>
          </li>
        ))}
      </ul>
    ) : (
      <p style="color:var(--muted);">Nothing here yet — longer pieces are on the way.</p>
    )}
  </section>

  <section class="reveal" style="margin-top:2.5rem;">
    <h2>fragments</h2>
    <div class="fragments">
      {fragments.map((f) => (
        <figure class="fragment">
          <p class="voice">{f.data.text}</p>
          <figcaption>{fmt(f.data.date)}</figcaption>
        </figure>
      ))}
    </div>
  </section>

</Base>
