---
import Project from "../../layouts/Project.astro";
---

<Project
  title="Pediatric Anxiety Research Center"
  kind="full stack at brown · team project"
  description="Redesigned website for the Pediatric Anxiety Research Center at Brown."
  lead="A Fall 2025 team project with Full Stack at Brown — we redesigned the public site for the Pediatric Anxiety Research Center, a clinical research program at Bradley Hospital. I owned the site-wide navigation and the Training section."
  links={[
    { label: "Visit live site →", href: "https://www.parcanxiety.org/", primary: true },
    // { label: "Source code →", href: "https://github.com/fullstackatbrown/project-parc" },
  ]}
  media={{
    kind: "image",
    src: "/project_gifs/parc-nav.png",
    alt: "PARC homepage showing the site-wide navigation bar, PARC branding, and Donate call-to-action",
  }}
  facts={[
    { label: "Role", value: "Frontend Developer" },
    { label: "Where", value: "Providence, RI" },
    { label: "When", value: "Fall 2025" },
    { label: "Team", value: "Full Stack at Brown" },
  ]}
  stack={["React", "Vite", "Tailwind", "React Router", "Framer Motion", "Cosmic CMS", "Firebase"]}
>
  <section>
    <h2>The client</h2>
    <p>
      PARC has provided assessment and treatment for children with OCD and anxiety disorders at
      Bradley Hospital since 1999.
      <!-- Their old site buried important paths — outpatient services,
      intensive programs, active research studies — under layers of clinical language. Families
      looking for help shouldn't have to hunt for it. -->
    </p>
    <p>
      <a href="https://www.fullstackatbrown.com/" target="_blank" rel="noreferrer">Full Stack at Brown</a>
      is Brown's student web development org; since 2019 it has built sites pro-bono for local
      nonprofits and research teams. 
    </p>
  </section>

  <section>
    <!-- <h2>My role</h2>
    <p>
      I was the frontend developer responsible for how people move through the site: owning the
      navigation, restructuring the information architecture into four clear top-level sections —
      Treatment, Research, Training, About — and building the Training pages end to end. My work sat
      where design handoff met routing: turning Figma layouts into reusable React components and
      wiring them into the app.
    </p> -->
  </section>

  <section>
    <h2>What I built</h2>
    <ul>
      <li>
        A site-wide <strong>navigation system</strong> (React + Tailwind) that became the single
        source of truth for every path: multi-level dropdowns for Treatment and Research, full-width
        dropdown panels, active-page highlighting, and a persistent Donate call-to-action.
      </li>
      <li>
        The full <strong>Training section</strong> — Services, Partnerships, and the landing page —
        plus the site <strong>footer</strong> with institutional partner branding.
      </li>
      <li>
        <strong>Client-side routing</strong> in React Router tying every new page into the app, on the
        team's Vite + Tailwind + headless-CMS stack.
      </li>
    </ul>
  </section>

