---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essays = await getCollection("words");
  return essays.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Base title={entry.data.title} description={entry.data.summary ?? entry.data.title}>
  <article class="prose" style="max-width:62ch; margin:0 auto; padding:2rem 0;">
    <a href="/words" class="eyebrow" style="display:inline-block; margin-bottom:1rem;">← words</a>
    <h1>{entry.data.title}</h1>
    <p style="color:var(--muted); margin-top:-0.4rem;">{fmt(entry.data.date)}</p>
    <div style="margin-top:1.5rem;">
      <Content />
    </div>
  </article>
</Base>
