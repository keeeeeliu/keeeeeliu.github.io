---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const quotes = await getCollection("quotes");
---

<Base title="collected" description="Things I love, that I didn't make — songs, books, excerpts, and more.">
  <section class="hero" style="padding-bottom:1.5rem;">
    <span class="eyebrow">collected</span>
    <h1>Things worth keeping</h1>
    <p class="lead">Things I love that I didn't make — songs, books, excerpts, objects, a certain kind of light. A running collection.</p>
  </section>

  <section class="reveal">
    <h2>excerpts</h2>
    <div class="quotes">
      {quotes.map((q) => (
        <figure class="quote">
          {q.data.zh && <blockquote class="voice quote-zh">{q.data.zh}</blockquote>}
          {q.data.en && <p class="quote-en">{q.data.en}</p>}
          <figcaption>— {q.data.who}{q.data.source ? `, ${q.data.source}` : ""}</figcaption>
        </figure>
      ))}
    </div>
    <p style="color:var(--muted); margin-top:1.5rem;">Songs, books, and other loves will gather here too — coming soon.</p>
  </section>
</Base>
